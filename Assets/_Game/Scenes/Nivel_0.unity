      objectReference: {fileID: 517625522}
    - target: {fileID: 7937614872070986691, guid: f19968015d70e9b46b987a5bfe1dd7cc, type: 3}
      propertyPath: dialogueLines.Array.size
      value: 10
      objectReference: {fileID: 0}
    - target: {fileID: 7937614872070986691, guid: f19968015d70e9b46b987a5bfe1dd7cc, type: 3}
      propertyPath: 'dialogueLines.Array.data[0]'
      value: (Conectando...)
      objectReference: {fileID: 0}
    - target: {fileID: 7937614872070986691, guid: f19968015d70e9b46b987a5bfe1dd7cc, type: 3}
      propertyPath: 'dialogueLines.Array.data[1]'
      value: 'Jimi: Santo cielos estas vivo, '
      objectReference: {fileID: 0}
    - target: {fileID: 7937614872070986691, guid: f19968015d70e9b46b987a5bfe1dd7cc, type: 3}
      propertyPath: 'dialogueLines.Array.data[2]'
      value: 'Jimi: que bien que no te olvidastes del comunicador...'
      objectReference: {fileID: 0}
    - target: {fileID: 7937614872070986691, guid: f19968015d70e9b46b987a5bfe1dd7cc, type: 3}
      propertyPath: 'dialogueLines.Array.data[3]'
      value: 'Jimi: Y tranquilo la ayuda ya biene solo espera unas horas...'
      objectReference: {fileID: 0}
    - target: {fileID: 7937614872070986691, guid: f19968015d70e9b46b987a5bfe1dd7cc, type: 3}
      propertyPath: 'dialogueLines.Array.data[4]'
      value: 'Jimi: Ten cuidado nadie estuvo tan profundo antes '
      objectReference: {fileID: 0}
    - target: {fileID: 7937614872070986691, guid: f19968015d70e9b46b987a5bfe1dd7cc, type: 3}
      propertyPath: 'dialogueLines.Array.data[5]'
      value: '(Interferencia...) '
      objectReference: {fileID: 0}
    - target: {fileID: 7937614872070986691, guid: f19968015d70e9b46b987a5bfe1dd7cc, type: 3}
      propertyPath: 'dialogueLines.Array.data[6]'
      value: ' Capataz: Eh que bien estas vivo.'
      objectReference: {fileID: 0}
    - target: {fileID: 7937614872070986691, guid: f19968015d70e9b46b987a5bfe1dd7cc, type: 3}
      propertyPath: 'dialogueLines.Array.data[7]'
      value: ' Capataz: Me comentaron que estan en el fondo, asi que podrias hacernos
        un favor '
      objectReference: {fileID: 0}
    - target: {fileID: 7937614872070986691, guid: f19968015d70e9b46b987a5bfe1dd7cc, type: 3}
      propertyPath: 'dialogueLines.Array.data[8]'
      value: ' Capataz: Podrias traer la gema rara que estamos buscando...'
      objectReference: {fileID: 0}
    - target: {fileID: 7937614872070986691, guid: f19968015d70e9b46b987a5bfe1dd7cc, type: 3}
      propertyPath: 'dialogueLines.Array.data[9]'
      value: ' Capataz: Tal vez con eso te hacienda a mi mano derecha...'
      objectReference: {fileID: 0}
